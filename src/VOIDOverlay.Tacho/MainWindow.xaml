<Window x:Class="VOIDOverlay.Tacho.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VOID Overlay Tacho"
        Icon="pack://application:,,,/assets/Tacho.ico"
        Width="410"
        Height="42"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual">
    <Border x:Name="OverlaySurface" Background="Transparent" CornerRadius="5" Padding="10,4">
        <StackPanel x:Name="MetricsPanel" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Border>
</Window>
